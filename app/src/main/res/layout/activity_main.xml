<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    tools:context="Activities.MainActivity">
    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@mipmap/ic_launcher1"
        android:contentDescription="App Logo"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="90dp"
        android:layout_marginLeft="140dp"/>
<TextView
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:text="Dropper Wines"
    android:textSize="50sp"
    android:textColor="#17D31F"
    android:layout_marginTop="200dp"
    android:layout_marginLeft="40dp"
    />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="and Spirits"
        android:textSize="50sp"
        android:textColor="#17D31F"
        android:layout_marginTop="250dp"
        android:layout_marginLeft="70dp"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Welcome To Dropper Wines and Spirits"
        android:textSize="30sp"
        android:textColor="#CDA11C"
        android:layout_marginTop="320dp"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Elevating every Occasion with Premium Selection "
        android:textSize="20sp"
        android:textColor="@color/black"
        android:layout_marginTop="390dp"
        />
    <Button
        android:id="@+id/btnLogin"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="LOGIN"
        android:layout_marginTop="454dp"
        android:layout_marginLeft="30dp"/>
    <Button
        android:id="@+id/btnSignUp"
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:text="SIGN-UP"
        android:layout_marginTop="504dp"
        android:layout_marginLeft="30dp"/>


</RelativeLayout>